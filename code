<script>
  (function () {
    var urlD = "https://events.intersectioncapital.com/the-game-of-money-confirmed-d";
    var urlQ = "https://events.intersectioncapital.com/the-game-of-money-confirmed-q";
    var answer = "";
    var redirected = false;

    console.log("[HS-Redirect] Script loaded");

    function doRedirect() {
      if (redirected) return;
      redirected = true;
      var dest = (answer === "yes") ? urlQ : urlD;
      console.log("[HS-Redirect] Redirecting to:", dest, "(answer was:", answer + ")");
      window.location.href = dest;
    }

    // ─── METHOD 1: postMessage listener ───
    // HubSpot iframe forms communicate via postMessage
    window.addEventListener("message", function (event) {
      var d = event.data;
      if (typeof d === "string") {
        try { d = JSON.parse(d); } catch (e) { return; }
      }
      if (!d) return;

      // Log every HubSpot message for debugging
      if (d.type === "hsFormCallback") {
        console.log("[HS-Redirect] postMessage event:", d.eventName);
      }

      if (d.type === "hsFormCallback" && d.eventName === "onFormSubmit") {
        if (Array.isArray(d.data)) {
          for (var i = 0; i < d.data.length; i++) {
            if (d.data[i].name && d.data[i].name.indexOf("accredited_investor") !== -1) {
              answer = (d.data[i].value || "").trim().toLowerCase();
              console.log("[HS-Redirect] Answer from postMessage:", answer);
            }
          }
        }
        // Fallback: redirect after delay if onFormSubmitted never fires
        setTimeout(doRedirect, 4000);
      }

      if (d.type === "hsFormCallback" && d.eventName === "onFormSubmitted") {
        doRedirect();
      }
    });

    // ─── METHOD 2: DOM polling ───
    // Captures the field value continuously and detects when the form
    // transitions to a success/processing state (works for both inline
    // and iframe forms since we watch the parent container)
    var submitDetected = false;
    setInterval(function () {
      var container = document.getElementById("hubspotForm");
      if (!container) return;

      // Try to read the select value from an inline form
      var sel = container.querySelector('select[name*="accredited_investor"]');
      if (sel && sel.value) {
        answer = sel.value.trim().toLowerCase();
      }

      // Detect HubSpot inline success message
      if (container.querySelector(".submitted-message")) {
        console.log("[HS-Redirect] Success message found in DOM");
        doRedirect();
        return;
      }

      // Detect "Processing" state: the form fields disappear and only
      // a loading/processing indicator remains. Check if form inputs
      // are gone but the container still has content.
      var inputs = container.querySelectorAll("input, select, textarea");
      var text = container.innerText || "";
